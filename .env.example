# Copy to .env. Passwords and the encryption secret stay in this file, not in the database volume.
# Generate values with: openssl rand -hex 24  and  openssl rand -hex 32

# Postgres role, database, and password. Use hex so the password is safe inside DATABASE_URL.
POSTGRES_USER=harbor
POSTGRES_DB=harbor
POSTGRES_PASSWORD=

# 32 bytes, or 64 hex characters. Required. Changing it makes stored API keys unreadable.
KEY_ENCRYPTION_SECRET=

# Create the first admin at startup. Remove ADMIN_PASSWORD from .env after the first successful start.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Alternative to ADMIN_USERNAME: a one-time token for POST /api/setup/admin. At least 16 characters.
# Send it once as JSON {"username","password","token"}. A second use is rejected.
BOOTSTRAP_TOKEN=

# Host port published to the machine. The process inside the container listens on 8080.
HARBOR_PORT=8080

# Upstream API origin. No path, user, or password.
DEEPSEEK_API_ORIGIN=https://api.deepseek.com

# Comma-separated browser origins. No wildcard. Same-origin pages do not need this.
# Add capacitor://localhost if the Android app talks to this server.
CORS_ORIGINS=http://localhost:8080

# 1 only behind a proxy that replaces X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY=0

# 1, 0, or auto. auto marks the session cookie Secure on HTTPS, including X-Forwarded-Proto when TRUST_PROXY=1.
COOKIE_SECURE=auto

# 1 sends HSTS on every response, including plain HTTP.
HARBOR_HSTS=0

# info, warn, or error. Lines are JSON. Message text and API keys are omitted.
LOG_LEVEL=info

# Lifetime of a new invite code, in hours. 1 to 720. Default 7 days.
INVITE_TTL_HOURS=168

# Leave unset. 1 lets the first visitor create the admin.
# ALLOW_OPEN_SETUP=0

# Leave unset. 1 deletes accounts when NODE_ENV is not production.
# E2E_RESET=0

# Image default is /app/public. Set only if you mount a different build.
# STATIC_DIR=/app/public

# Image default is 8080. The published host port is HARBOR_PORT.
# PORT=8080

# Compose sets this from POSTGRES_*. Replace the harbor service value to use another database.
# DATABASE_URL=postgres://harbor:password@db:5432/harbor
