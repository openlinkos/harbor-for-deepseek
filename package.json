{
  "name": "harbor",
  "private": true,
  "version": "0.1.0",
  "description": "Harbor — unofficial community chat client for the official DeepSeek API.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@harbor/web",
    "build": "turbo run build --filter=@harbor/web",
    "preview": "pnpm --filter @harbor/web preview",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "e2e": "pnpm --filter @harbor/web e2e",
    "e2e:server": "pnpm --filter @harbor/web exec playwright test -c playwright.server.config.ts",
    "scan-secrets": "node scripts/scan-secrets.mjs"
  },
  "devDependencies": {
    "oxlint": "1.28.0",
    "turbo": "2.6.1",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
