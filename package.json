{
  "name": "deepapi",
  "private": true,
  "version": "0.1.0",
  "description": "DeepAPI — a chat client for the DeepSeek API. The key and messages stay on the device.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@deepapi/web",
    "build": "turbo run build --filter=@deepapi/web",
    "preview": "pnpm --filter @deepapi/web preview",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --experimental-strip-types --test tools/style-audit/bookmarklet.test.ts && node --test scripts/check-version.test.mjs",
    "check-version": "node scripts/check-version.mjs",
    "lint": "turbo run lint",
    "e2e": "pnpm --filter @deepapi/web e2e",
    "style:audit": "node --experimental-strip-types tools/style-audit/run.ts",
    "e2e:server": "pnpm --filter @deepapi/web exec playwright test -c playwright.server.config.ts",
    "scan-secrets": "node scripts/scan-secrets.mjs",
    "check-css": "node scripts/check-css.mjs apps/web/src/styles.css apps/web/src/theme.css"
  },
  "devDependencies": {
    "oxlint": "1.28.0",
    "postcss": "8.5.33",
    "turbo": "2.6.1",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
