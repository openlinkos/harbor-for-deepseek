{
  "name": "@deepapi/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/server.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@deepapi/api-client": "workspace:*",
    "@deepapi/pricing": "workspace:*",
    "@deepapi/sse": "workspace:*",
    "@deepapi/types": "workspace:*",
    "@hono/node-server": "1.13.7",
    "hono": "4.6.14",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "esbuild": "0.24.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
